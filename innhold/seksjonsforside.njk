---
# Adressen til et menypunkt (f.eks. /referater/) sender videre til første side i menyen
pagination:
  data: nettsted.meny
  size: 1
  alias: punkt
permalink: "/{{ punkt.mappe }}/"
layout: false
eleventyExcludeFromCollections: true
---
{%- set forste = collections[punkt.mappe] | first -%}
<!doctype html>
<html lang="nb">
<head>
	<meta charset="utf-8">
	<title>{{ punkt.tittel }} – {{ nettsted.tittel }}</title>
	<meta http-equiv="refresh" content="0; url={{ forste.url }}">
	<link rel="canonical" href="{{ forste.url }}">
</head>
<body><a href="{{ forste.url }}">{{ forste.data.title }}</a></body>
</html>
